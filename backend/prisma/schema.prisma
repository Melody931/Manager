
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  CAJERO
}

enum Plan {
  BASICO
  PREMIUM
}

enum TipoItem {
  PRODUCTO
  SERVICIO
}

enum TipoUso {
  AUTOMATICO
  MANUAL
}

model Negocio {
  id             Int      @id @default(autoincrement())
  nombre         String
  tipo           String
  moneda         String   @default("DOP")
  zonaHoraria    String   @default("America/Santo_Domingo")
  plan           Plan     @default(BASICO)
  configuracion  Json     @default("{}")
  creadoEn       DateTime @default(now())

  usuarios       Usuario[]
  clientes       Cliente[]
  items          Item[]
  ventas         Venta[]
  gastos         Gasto[]
  informes       InformeIA[]
  usosIA         UsoIA[]
}

model Usuario {
  id           Int     @id @default(autoincrement())
  negocioId    Int
  nombre       String
  email        String  @unique
  passwordHash String
  rol          Rol
  activo       Boolean @default(true)

  negocio      Negocio @relation(fields: [negocioId], references: [id])
  ventas       Venta[]

  @@index([negocioId])
}

model Cliente {
  id         Int      @id @default(autoincrement())
  negocioId  Int
  nombre     String
  telefono   String?
  datosExtra Json?
  creadoEn   DateTime @default(now())

  negocio    Negocio @relation(fields: [negocioId], references: [id])
  ventas     Venta[]

  @@index([negocioId])
}

model Item {
  id             Int      @id @default(autoincrement())
  negocioId      Int
  tipo           TipoItem
  nombre         String
  precio         Decimal  @db.Decimal(12, 2)
  costo          Decimal? @db.Decimal(12, 2)
  controlaStock  Boolean  @default(false)
  stock          Int      @default(0)
  stockMinimo    Int      @default(0)
  activo         Boolean  @default(true)
  datosExtra     Json?

  negocio        Negocio @relation(fields: [negocioId], references: [id])
  detalles       VentaDetalle[]

  @@index([negocioId])
}

model Venta {
  id          Int      @id @default(autoincrement())
  negocioId   Int
  clienteId   Int?
  usuarioId   Int
  fecha       DateTime @default(now())
  total       Decimal  @db.Decimal(12, 2)
  metodoPago  String

  negocio     Negocio @relation(fields: [negocioId], references: [id])
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  detalles    VentaDetalle[]

  @@index([negocioId, fecha])
}

model VentaDetalle {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  itemId         Int
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(12, 2)
  costoUnitario  Decimal? @db.Decimal(12, 2)

  venta          Venta @relation(fields: [ventaId], references: [id])
  item           Item  @relation(fields: [itemId], references: [id])

  @@index([ventaId])
  @@index([itemId])
}

model Gasto {
  id          Int      @id @default(autoincrement())
  negocioId   Int
  categoria   String
  monto       Decimal  @db.Decimal(12, 2)
  fecha       DateTime
  nota        String?

  negocio     Negocio @relation(fields: [negocioId], references: [id])

  @@index([negocioId, fecha])
}

model InformeIA {
  id             Int      @id @default(autoincrement())
  negocioId      Int
  periodoInicio  DateTime
  periodoFin     DateTime
  metricas       Json
  metricasHash   String
  contenido      String
  tokensEntrada  Int
  tokensSalida   Int
  tipo           TipoUso
  creadoEn       DateTime @default(now())

  negocio        Negocio @relation(fields: [negocioId], references: [id])

  @@index([negocioId, creadoEn])
}

model UsoIA {
  id          Int      @id @default(autoincrement())
  negocioId   Int
  tipo        TipoUso
  tokens      Int
  creadoEn    DateTime @default(now())

  negocio     Negocio @relation(fields: [negocioId], references: [id])

  @@index([negocioId, creadoEn])
}
